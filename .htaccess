RewriteEngine On

# DirectoryIndex configuration
DirectoryIndex index.php public/index.php

# Block access to application source, deployment metadata, and private configuration.
RewriteRule ^(views|app|config|database|scratch|storage|requirements|printer_service|cron|routes|\.git|\.github|\.vscode)(/|$) - [F,L,NC]
RewriteRule ^\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(README(?:\..*)?|composer\.(json|lock)|package(-lock)?\.json|.*\.md)$ - [F,L,NC]

# Directly serve uploads and assets from public folder
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# If the request is not for an existing file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Route everything to public/index.php
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
