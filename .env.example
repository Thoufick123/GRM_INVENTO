APP_ENV=production
APP_NAME="GRM Inventory Management"
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=false

# Copy the database name, username, host, and port exactly as shown in Hostinger hPanel.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hostinger_account_database
DB_USERNAME=hostinger_account_user
DB_PASSWORD=replace_with_a_strong_database_password

# Optional: enable Cloudinary only if the application should upload media there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional: required only for email-based automated backups.
BACKUP_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
